// Базовый контент Ferrustry v0 (вертикальный срез этапа 1).
// Числа — стартовый баланс, будут пересматриваться геймдизайном.
(
    floors: [
        (name: "basalt", buildable: true),
        (name: "ash", buildable: true),
        (name: "slag_pool", buildable: false),
    ],
    items: [
        (name: "iron_ore"),
        (name: "carbon"),
        (name: "iron_ingot"),
        (name: "steel"),
    ],
    fluids: [
        (name: "water"),
    ],
    // враги волн: скорость и радиус — в 1/256 тайла
    units: [
        (name: "crawler", health: 40, speed: 20, damage: 6, cooldown: 20, radius: 80),
        (name: "brute", health: 260, speed: 10, damage: 25, cooldown: 30, radius: 120),
        // плюётся с 4 тайлов: держится вне досягаемости стен, но в радиусе турелей
        (name: "spitter", health: 50, speed: 14, damage: 8, cooldown: 45, radius: 80, range: 4, projectile_speed: 40),
        // броня 8: пушечный снаряд (12) наносит лишь 4; дуговая турель броню игнорирует
        (name: "shellback", health: 320, speed: 8, damage: 30, cooldown: 40, radius: 130, armor: 8),
    ],
    // состав волн: с волны from_wave приходит count врагов, каждые every волн — ещё grow
    waves: [
        (unit: "crawler", from_wave: 1, count: 5, grow: 3, every: 1),
        (unit: "brute", from_wave: 2, count: 1, grow: 1, every: 1),
        (unit: "spitter", from_wave: 3, count: 1, grow: 1, every: 2),
        (unit: "shellback", from_wave: 6, count: 1, grow: 1, every: 2),
    ],
    // шум базы ускоряет таймер волн: +2% за единицу шума, не больше +150% (в 2,5 раза)
    noise: (speedup_per_unit: 20, max_speedup: 1500),
    // руины (D-01 «Reforge»): ремонт — 30% стоимости оригинала, снос — 50% стоимости оригинала
    ruins: (repair_percent: 30, salvage_percent: 50),
    ores: [
        (name: "iron_vein", item: "iron_ore"),
        (name: "carbon_seam", item: "carbon"),
    ],
    blocks: [
        (
            name: "conveyor",
            cost: [("iron_ingot", 1)],
            size: 1,
            // единиц пути за тик; тайл = 256 единиц, шаг между предметами = 64
            kind: Conveyor(speed: 16),
        ),
        (
            name: "bore",
            cost: [("iron_ingot", 10)],
            size: 2,
            noise: 1,
            // при полном покрытии рудой (4 тайла): 1 предмет за 40 тиков
            kind: Drill(base_ticks: 40, buffer: 10),
        ),
        (
            name: "smelter",
            cost: [("iron_ingot", 25)],
            size: 2,
            noise: 2,
            kind: Crafter(
                inputs: [("iron_ore", 2)],
                outputs: [("iron_ingot", 1)],
                craft_ticks: 30,
                power_use: 4,
                buffer: 10,
            ),
        ),
        (
            name: "steel_forge",
            cost: [("iron_ingot", 40)],
            size: 2,
            noise: 4,
            kind: Crafter(
                inputs: [("iron_ingot", 2), ("carbon", 1)],
                outputs: [("steel", 1)],
                craft_ticks: 60,
                power_use: 10,
                buffer: 10,
                // кузница греется: без охлаждения через ~40 тиков работы начинает замедляться
                heat: 6,
                cooling: 1,
                heat_capacity: 300,
            ),
        ),
        (
            name: "wind_turbine",
            cost: [("iron_ingot", 10)],
            size: 1,
            kind: Generator(power: 2),
        ),
        (
            name: "burner",
            cost: [("iron_ingot", 25)],
            size: 2,
            noise: 3,
            // 1 уголь = 120 тиков по 12 энергии; горит, пока есть топливо
            kind: Generator(power: 12, fuel: Some("carbon"), burn_ticks: 120, buffer: 10),
        ),
        (
            name: "depot",
            cost: [("iron_ingot", 20)],
            size: 2,
            // буфер: принимает с трёх сторон, выдаёт вперёд по 1 предмету за тик
            kind: Depot(capacity: 300),
        ),
        (
            name: "power_node",
            cost: [("iron_ingot", 4)],
            size: 1,
            kind: PowerNode(range: 6),
        ),
        (
            name: "splitter",
            cost: [("iron_ingot", 3)],
            size: 1,
            kind: Splitter,
        ),
        (
            name: "sorter",
            cost: [("iron_ingot", 4)],
            size: 1,
            kind: Sorter,
        ),
        (
            name: "overflow_gate",
            cost: [("iron_ingot", 4)],
            size: 1,
            // прямо, пока впереди есть место; излишек — вбок
            kind: Overflow,
        ),
        (
            name: "bridge_conveyor",
            cost: [("iron_ingot", 6)],
            size: 1,
            // мост «прыгает» до 4 тайлов к следующему мосту того же направления;
            // 1 предмет за 4 тика — как пропускная способность ленты
            kind: Bridge(range: 4, interval: 4, buffer: 4),
        ),
        (
            name: "battery",
            cost: [("iron_ingot", 15), ("carbon", 2)],
            size: 1,
            kind: Battery(capacity: 2000),
        ),
        (
            name: "pipe",
            cost: [("iron_ingot", 1)],
            size: 1,
            kind: Pipe(capacity: 20),
        ),
        (
            name: "condenser",
            cost: [("iron_ingot", 30)],
            size: 2,
            // вода из воздуха: 2 ед./тик при 3 энергии/тик
            kind: Condenser(fluid: "water", rate: 2, power_use: 3, capacity: 40),
        ),
        (
            name: "cooling_tower",
            cost: [("iron_ingot", 30)],
            size: 2,
            // 1 ед. воды/тик снимает 8 тепла
            kind: CoolingTower(fluid: "water", rate: 1, cooling: 8, heat_capacity: 100),
        ),
        (
            name: "heat_pipe",
            cost: [("iron_ingot", 2)],
            size: 1,
            kind: HeatPipe(heat_capacity: 50),
        ),
        (
            name: "radiator",
            cost: [("iron_ingot", 6)],
            size: 1,
            kind: Radiator(dissipation: 2, heat_capacity: 50),
        ),
        (
            name: "heat_engine",
            cost: [("iron_ingot", 40), ("steel", 10)],
            size: 2,
            // до 8 тепла/тик → 4 энергии/тик (КПД 50%)
            kind: HeatEngine(max_heat: 8, power_per_heat_permille: 500, heat_capacity: 200),
        ),
        (
            name: "gun_turret",
            cost: [("iron_ingot", 45)],
            size: 2,
            health: 400,
            // 1 слиток = 2 выстрела по 12 урона; радиус 9 тайлов
            kind: Turret(range: 9, damage: 12, reload: 15, ammo: "iron_ingot", shots_per_item: 2, projectile_speed: 96, buffer: 10),
        ),
        (
            name: "arc_tower",
            cost: [("iron_ingot", 40), ("steel", 15)],
            size: 2,
            health: 350,
            // разряд 40 урона каждые 25 тиков, 8 энергии за тик перезарядки; броня не помогает
            kind: ArcTurret(range: 7, damage: 40, reload: 25, power_use: 8),
        ),
        (
            name: "iron_wall",
            cost: [("iron_ingot", 4)],
            size: 1,
            health: 400,
            kind: Wall,
        ),
        (
            name: "core",
            cost: [("iron_ingot", 500), ("steel", 100)],
            size: 3,
            health: 3000,
            kind: Core(capacity: 4000),
        ),
        // Руины (D-01): генератор карты расставляет их как брошенные аванпосты. Не работают;
        // ремонт и снос — по правилу `ruins` выше. Стоимости нет: построить руину нельзя.
        (name: "ruined_bore", size: 2, health: 120, kind: Ruin(of: "bore")),
        (name: "ruined_smelter", size: 2, health: 150, kind: Ruin(of: "smelter")),
        (name: "ruined_steel_forge", size: 2, health: 200, kind: Ruin(of: "steel_forge")),
        (name: "ruined_wind_turbine", size: 1, health: 60, kind: Ruin(of: "wind_turbine")),
        (name: "ruined_gun_turret", size: 2, health: 200, kind: Ruin(of: "gun_turret")),
    ],
)
