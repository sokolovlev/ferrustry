// Базовый контент Ferrustry v0 (вертикальный срез этапа 1).
// Числа — стартовый баланс, будут пересматриваться геймдизайном.
(
    floors: [
        (name: "basalt", buildable: true),
        (name: "ash", buildable: true),
        (name: "slag_pool", buildable: false),
    ],
    items: [
        (name: "iron_ore"),
        (name: "carbon"),
        (name: "iron_ingot"),
        (name: "steel"),
    ],
    fluids: [
        (name: "water"),
    ],
    ores: [
        (name: "iron_vein", item: "iron_ore"),
        (name: "carbon_seam", item: "carbon"),
    ],
    blocks: [
        (
            name: "conveyor",
            cost: [("iron_ingot", 1)],
            size: 1,
            // единиц пути за тик; тайл = 256 единиц, шаг между предметами = 64
            kind: Conveyor(speed: 16),
        ),
        (
            name: "bore",
            cost: [("iron_ingot", 10)],
            size: 2,
            // при полном покрытии рудой (4 тайла): 1 предмет за 40 тиков
            kind: Drill(base_ticks: 40, buffer: 10),
        ),
        (
            name: "smelter",
            cost: [("iron_ingot", 25)],
            size: 2,
            kind: Crafter(
                inputs: [("iron_ore", 2)],
                outputs: [("iron_ingot", 1)],
                craft_ticks: 30,
                power_use: 4,
                buffer: 10,
            ),
        ),
        (
            name: "steel_forge",
            cost: [("iron_ingot", 40)],
            size: 2,
            kind: Crafter(
                inputs: [("iron_ingot", 2), ("carbon", 1)],
                outputs: [("steel", 1)],
                craft_ticks: 60,
                power_use: 10,
                buffer: 10,
                // кузница греется: без охлаждения через ~40 тиков работы начинает замедляться
                heat: 6,
                cooling: 1,
                heat_capacity: 300,
            ),
        ),
        (
            name: "wind_turbine",
            cost: [("iron_ingot", 10)],
            size: 1,
            kind: Generator(power: 2),
        ),
        (
            name: "power_node",
            cost: [("iron_ingot", 4)],
            size: 1,
            kind: PowerNode(range: 6),
        ),
        (
            name: "splitter",
            cost: [("iron_ingot", 3)],
            size: 1,
            kind: Splitter,
        ),
        (
            name: "sorter",
            cost: [("iron_ingot", 4)],
            size: 1,
            kind: Sorter,
        ),
        (
            name: "bridge_conveyor",
            cost: [("iron_ingot", 6)],
            size: 1,
            // мост «прыгает» до 4 тайлов к следующему мосту того же направления;
            // 1 предмет за 4 тика — как пропускная способность ленты
            kind: Bridge(range: 4, interval: 4, buffer: 4),
        ),
        (
            name: "battery",
            cost: [("iron_ingot", 15), ("carbon", 2)],
            size: 1,
            kind: Battery(capacity: 2000),
        ),
        (
            name: "pipe",
            cost: [("iron_ingot", 1)],
            size: 1,
            kind: Pipe(capacity: 20),
        ),
        (
            name: "condenser",
            cost: [("iron_ingot", 30)],
            size: 2,
            // вода из воздуха: 2 ед./тик при 3 энергии/тик
            kind: Condenser(fluid: "water", rate: 2, power_use: 3, capacity: 40),
        ),
        (
            name: "cooling_tower",
            cost: [("iron_ingot", 30)],
            size: 2,
            // 1 ед. воды/тик снимает 8 тепла
            kind: CoolingTower(fluid: "water", rate: 1, cooling: 8, heat_capacity: 100),
        ),
        (
            name: "heat_pipe",
            cost: [("iron_ingot", 2)],
            size: 1,
            kind: HeatPipe(heat_capacity: 50),
        ),
        (
            name: "radiator",
            cost: [("iron_ingot", 6)],
            size: 1,
            kind: Radiator(dissipation: 2, heat_capacity: 50),
        ),
        (
            name: "heat_engine",
            cost: [("iron_ingot", 40), ("steel", 10)],
            size: 2,
            // до 8 тепла/тик → 4 энергии/тик (КПД 50%)
            kind: HeatEngine(max_heat: 8, power_per_heat_permille: 500, heat_capacity: 200),
        ),
        (
            name: "core",
            cost: [("iron_ingot", 500), ("steel", 100)],
            size: 3,
            kind: Core(capacity: 4000),
        ),
    ],
)
